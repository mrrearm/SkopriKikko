# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Opzionale per la build APK Android su GitHub.
# Impostalo nelle Variables del repository GitHub con l'URL pubblico del server
# se vuoi abilitare la ricerca dinamica online anche dentro l'APK.
VITE_API_BASE_URL=""
